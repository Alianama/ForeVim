# ──────────────────────────────────────────────────────────────────────────────
# ForeVim Environment Configuration Template
# Copy this file to .env and adjust configurations before launching containers.
# ──────────────────────────────────────────────────────────────────────────────

# 1. PostgreSQL Database Configuration
# These credentials will be used to initialize the PostgreSQL database container.
POSTGRES_USER=forevim
POSTGRES_PASSWORD=my_secure_db_password
POSTGRES_DB=forevim

# 2. Security
# Secret key for JWT hashing. Generate a cryptographically secure hex key:
# Run in shell: openssl rand -hex 32
SECRET_KEY=generate_your_own_secure_random_key_here

# 3. CORS Configuration
# Comma-separated list of frontends allowed to access the backend API.
# Contains the port where the unified container Nginx proxy is exposed.
ALLOWED_ORIGINS_STR=http://localhost,http://127.0.0.1,http://localhost:80

# 4. Next.js Frontend Configuration (Browser access URLs)
# POINT THESE TO THE URL WHERE USERS WILL ACCESS THE APPLICATION FROM THEIR BROWSER.
# If hosting on a server with IP 192.168.1.50, change localhost to 192.168.1.50.
NEXT_PUBLIC_API_URL=http://localhost:80/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:80
